<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="gymPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>jpa.model.AthleteEnt</class>
        <class>jpa.model.TrainingRoomEnt</class>
        <class>jpa.model.GymRoomEnt</class>
        <class>jpa.model.PoolRoomEnt</class>
        <class>jpa.model.TrainingEnt</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Połączenie z bazą uruchamianą z Docker/docker-compose.yml -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/nbd"/>
            <property name="jakarta.persistence.jdbc.user" value="nbd"/>
            <property name="jakarta.persistence.jdbc.password" value="nbdpassword"/>

            <!-- Schemat generowany z modelu (podejście model -> baza danych) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Poziom izolacji transakcji: 2 = java.sql.Connection.TRANSACTION_READ_COMMITTED.
                 Spójność rezerwacji zapewnia blokada pesymistyczna wiersza sali (patrz
                 JpaTrainingRoomRepository.findByIdForUpdate), więc SERIALIZABLE nie jest potrzebny. -->
            <property name="hibernate.connection.isolation" value="2"/>

            <!-- Wbudowana pula Hibernate: wystarcza do nauki i testów, nie do produkcji. -->
            <property name="hibernate.connection.pool_size" value="32"/>

            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>